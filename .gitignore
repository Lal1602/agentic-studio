# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agentic app local data — chat history, saved preferences, local db.
# Personal/sensitive by nature, never meant to leave this machine.
# .agentic-chats.json is the legacy chat history format (pre SQLite
# migration) — still ignored here in case it's still on disk locally;
# .agentic-chats.db (and its WAL/SHM sidecar files) is the current one.
/.agentic-chats.json
/.agentic-chats.db
/.agentic-chats.db-wal
/.agentic-chats.db-shm
/.agentic-memory.json
/dev.db
/workspace/output/

# agentic app settings — local workspace path + any MCP server config,
# which can include env vars (API keys/tokens) for third-party MCP servers.
/.agentic-settings.json

# local dev scratch — ad hoc manual test scripts and debug screenshots,
# not part of the real Vitest suite and not meant for the public repo.
/test-office.ts
/test-search.ts
/test-tools.txt
/Claude outputs/
